# ---------- PostgreSQL ----------
# Local development credentials. Use separate application/monitoring roles for deployment.
POSTGRES_USER=syncspace
POSTGRES_PASSWORD=pass
POSTGRES_DB=syncspace
# Container-to-container address; URL-encode special characters in URL credentials.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---------- JWT / Auth ----------
JWT_SECRET=changeme_super_secret_jwt_key
JWT_REFRESH_SECRET=changeme_super_secret_refresh_key

# ---------- OAuth ----------
OAUTH_42_CLIENT_ID=changeme
OAUTH_42_CLIENT_SECRET=changeme
OAUTH_GITHUB_CLIENT_ID=changeme
OAUTH_GITHUB_CLIENT_SECRET=changeme

# ---------- Vault ----------
VAULT_DEV_TOKEN=root
VAULT_ADDR=http://vault:8200

# ---------- Frontend ----------
VITE_API_URL=https://localhost:8443/api
VITE_WS_URL=wss://localhost:8443/ws/

# ---------- Optional logging / monitoring (local placeholders only) ----------
ELASTIC_PASSWORD=changeme_elastic_password
KIBANA_PASSWORD=changeme_kibana_password
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password

# Unprivileged host ports for rootless Docker
HTTP_PORT=8080
HTTPS_PORT=8443
